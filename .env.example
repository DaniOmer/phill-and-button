# Supabase
# Récupérer ces valeurs dans Project Settings > API sur https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mot de passe de la base de données (Project Settings > Database)
SUPABASE_DB_PASSWORD=your-db-password

# Connexion DB via le pooler Supabase (REQUIS en serverless/Vercel : la
# connexion directe db.<ref>.supabase.co est IPv6-only et injoignable).
# Project Settings > Database > Connection string > "Transaction pooler".
# En dev local, laisser vide : la connexion directe est dérivée automatiquement.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# WhatsApp Business
# Numéro au format international sans "+" ni espaces (ex: 221771234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=221771234567

# URL publique du site (SEO, sitemap, robots, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.phill-and-button.com
